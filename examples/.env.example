# Copy to ".env" next to where you start the server (never commit the real file).
FREESOUND_API_KEY=your_freesound_api_key

# Optional
# MCP_FREESOUND_TRANSPORT=http
# MCP_FREESOUND_HOST=127.0.0.1
# MCP_FREESOUND_PORT=8000
# MCP_FREESOUND_PATH=/mcp
# MCP_FREESOUND_AUTH_TOKEN=generate-with-mcp-freesound-token
# MCP_FREESOUND_ALLOWED_ORIGINS=https://my-app.example
# MCP_FREESOUND_TLS_CERT=/path/to/cert.pem
# MCP_FREESOUND_TLS_KEY=/path/to/key.pem
# MCP_FREESOUND_DOWNLOAD_DIR=~/Downloads/freesound
# MCP_FREESOUND_ALLOW_DOWNLOADS=true
# MCP_FREESOUND_TIMEOUT=30
# MCP_FREESOUND_LOG_LEVEL=INFO
